% ======================================== Apêndices e Anexos =======================================
% --- AUTOMAÇÃO: Forçar "Apêndice A" ou "Anexo A" no Bookmark ---
\makeatletter
\let\oldchapter\chapter
\renewcommand{\chapter}{\@ifstar{\oldchapter*}{\@ifnextchar[{\chap@opt}{\chap@noopt}}}

\def\chap@opt[#1]#2{%
    \ifthenelse{\boolean{abntex@apendiceousecao}}{%
        \bookmarksetup{numbered=false}%
        % \appendixname assume "Apêndice" ou "Anexo" conforme o ambiente atual
        \oldchapter[\texorpdfstring{#1}{\appendixname\space\thechapter\space -- #1}]{#2}%
        \bookmarksetup{numbered=true}% 
    }{%
        \oldchapter[#1]{#2}%
    }%
}

\def\chap@noopt#1{%
    \ifthenelse{\boolean{abntex@apendiceousecao}}{%
        \bookmarksetup{numbered=false}%
        \oldchapter[\texorpdfstring{#1}{\appendixname\space\thechapter\space -- #1}]{#1}%
        \bookmarksetup{numbered=true}%
    }{%
        \oldchapter{#1}%
    }%
}
\makeatother
% ======================================== Apêndices e Anexos =======================================