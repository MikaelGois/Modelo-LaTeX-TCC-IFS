% ====================================== variáveis adicionais ======================================

% ============================================== capa ==============================================
\renewcommand{\imprimircapa}{ % Capa 
    \begin{capa}
        \thispagestyle{empty}
        \begin{center}
            \begin{DoubleSpace}
                \ifthenelse{\equal{\imprimirlogoinstituicao}{}}{}{\imprimirlogoinstituicao \\}
                \MakeUppercase{\imprimirinstituicao} \\
                \MakeUppercase{\imprimirdepartamento} \\
                \ifthenelse{\equal{\imprimircampus}{}}{}{\MakeUppercase{\imprimircampus \\}}
            \end{DoubleSpace}
            \vspace{3cm}
            \MakeUppercase{\imprimirautor} \\
            \vspace{3cm}
            \MakeUppercase{\textbf{\imprimirtitulo}}
            % ":" é adicionado de forma automática apenas se o subtítulo for preenchido.
            % "\unskip" remove o espaço extra antes dos dois-pontos caso o subtítulo for preenchido.
            \ifthenelse{\equal{\imprimirsubtitulo}{}}{}{\MakeUppercase{\textbf{\unskip: \\ \imprimirsubtitulo}} \\}
            \vfill
            {\large{\imprimirlocal, \imprimiruf \\ \imprimirano}}
        \end{center}
    \end{capa}
}
% ============================================== capa ==============================================

% ========================================= folha de rosto =========================================
\renewcommand{\imprimirfolhaderosto}{
    % \begin{folhaderosto}
    % \newpage
    % \thispagestyle{empty}
    \begin{center}
        \MakeUppercase{\imprimirautor} \\
        \vspace{4cm}
        \begin{DoubleSpace}
            \MakeUppercase{\textbf{\imprimirtitulo}}
            % ":" é adicionado de forma automática apenas se o subtítulo for preenchido.
            % "\unskip" remove o espaço extra antes dos dois-pontos caso o subtítulo for preenchido.
            \ifthenelse{\equal{\imprimirsubtitulo}{}}{}{\MakeUppercase{\textbf{\unskip: \\ \imprimirsubtitulo}} \\}
        \end{DoubleSpace}
    \end{center}
    \vspace{1cm}
    \begin{flushright}
        % Delocamento para a direita de 7 ou 8 cm, sendo 8 cm o mais comum para coincidir com o meio da folha
        \parbox{\dimexpr\textwidth-8cm\relax} {
            \imprimirpreambulo
            \vspace{1cm} \\
            \textbf{\imprimirorientadorRotulo}~\imprimirorientador \\
            \textbf{\imprimircoorientadorRotulo}~\imprimircoorientador
        }
    \end{flushright}
    \vfill
    \begin{center}
        {\large{\imprimirlocal, \imprimiruf \\ \imprimirano}}
    \end{center}
    % \end{folhaderosto}
}
% ========================================= folha de rosto =========================================

% ========================================= agradecimentos =========================================
\renewenvironment{agradecimentos}[1][\agradecimentosname]{%
    \cleardoublepage
    \thispagestyle{empty}
    \phantomsection
    \pdfbookmark[0]{#1}{agradecimentos.\thepage} % Bookmark do PDF usa o que você digitar (ex: Agradecimentos)
    \begin{center}
        \ABNTEXchapterfont\ABNTEXchapterfontsize
        \MakeUppercase{\textbf{#1}}
    \end{center}
}{\PRIVATEclearpageifneeded}
% ========================================= agradecimentos =========================================

% ======================================== resumo e abstract =======================================
\renewenvironment{resumo}[1][\resumoname]{%
    \cleardoublepage
    \thispagestyle{empty}
    \phantomsection
    \pdfbookmark[0]{#1}{resumo.\thepage} % Bookmark do PDF usa o que você digitar (ex: Resumo)
    \begin{center}
        \ABNTEXchapterfont\ABNTEXchapterfontsize
        \MakeUppercase{\textbf{#1}} % Texto no documento será sempre MAIÚSCULO (ex: RESUMO)
    \end{center}
    % \vspace{\onelineskip}
}{\PRIVATEclearpageifneeded}
