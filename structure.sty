% --- Comando para título SEM aparecer no índice do PDF ---
\newcommand{\pretextualchaptersilent}[1]{%
    \cleardoublepage
    \thispagestyle{empty}
    \begin{center}
        \ABNTEXchapterfont\ABNTEXchapterfontsize
