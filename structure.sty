% Força todos os títulos a usarem o tamanho definido no documento
\renewcommand{\ABNTEXchapterfontsize}{\normalsize}
\renewcommand{\ABNTEXsectionfontsize}{\normalsize}
\renewcommand{\ABNTEXsubsectionfontsize}{\normalsize}
\renewcommand{\ABNTEXsubsubsectionfontsize}{\normalsize}
\renewcommand{\ABNTEXsubsubsubsectionfontsize}{\normalsize}

% --- AJUSTE DE ESPAÇAMENTO ENTRE TÍTULO E TEXTO (Norma ABNT) ---
% Define o espaço após os títulos para ser exatamente de uma linha (1.5)
\setlength{\afterchapskip}{\onelineskip}   % Para Capítulos (\chapter)
\setlength{\aftersecskip}{\onelineskip}    % Para Seções (\section)
\setlength{\aftersubsecskip}{\onelineskip} % Para Subseções (\subsection)
\setlength{\aftersubsubsecskip}{\onelineskip} % Para Subsubseções (\subsubsection)

% Opcional: Ajuste do espaço ANTES do título (exceto no início da página)
\setlength{\beforechapskip}{0pt} % Capítulos sempre começam no topo da página
\setlength{\beforesecskip}{1.0\onelineskip}
\setlength{\beforesubsecskip}{1.0\onelineskip}

% --- CONFIGURAÇÃO DE CAPÍTULOS E SEÇÕES ---
\renewcommand{\pretextualchapter}[2][]{%
    \cleardoublepage
    \thispagestyle{empty}
    \phantomsection
    \ifthenelse{\equal{#1}{}}%
    {\pdfbookmark[0]{#2}{pretextual.\thepage}}% Se o opcional estiver vazio, usa o título normal no PDF
    {\pdfbookmark[0]{#1}{pretextual.\thepage}}% Se houver título opcional, usa ele no PDF
    \begin{center}
        \ABNTEXchapterfont\ABNTEXchapterfontsize
        \MakeUppercase{\textbf{#2}} % FORÇA MAIÚSCULO NO DOCUMENTO
    \end{center}
}

% --- CONFIGURAÇÃO AUTOMÁTICA DE METADADOS DO PDF ---
\AtBeginDocument{
    \hypersetup{
        % Metadados
        unicode=true,               % Permite acentos e caracteres especiais nos metadados
        pdftitle={\imprimirtitulo},
        pdfauthor={\imprimirautor},
        pdfsubject={\imprimirpreambulo},
        % Comportamento do Índice (Bookmarks)
        bookmarksnumbered=true,     % Mostra a numeração das seções no índice lateral
        bookmarksopen=true,         % Abre o índice lateral por padrão ao abrir o PDF
        bookmarksdepth=3,           % Define a profundidade: Capítulos, Seções e Subseções
        % Aparência Visual
        hidelinks                   % Remove as bordas coloridas dos links
    }
}

