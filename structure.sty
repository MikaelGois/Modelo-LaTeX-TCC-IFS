% ============================================== capa ==============================================
\renewcommand{\imprimircapa}{% 
    \begin{capa}
        \thispagestyle{empty}
        \begin{center}
            % \begin{DoubleSpace}
            \ifthenelse{\equal{\imprimirlogoinstituicao}{}}{}{\imprimirlogoinstituicao \\}
            \MakeUppercase{\imprimirinstituicao} \\
            \MakeUppercase{\imprimirdepartamento} \\
            \ifthenelse{\equal{\imprimircampus}{}}{}{\MakeUppercase{\imprimircampus \\}}
            % \end{DoubleSpace}
            \vspace{3cm}
            \MakeUppercase{\imprimirautor} \\
            \vspace{3cm}
            % \begin{DoubleSpace}
            \MakeUppercase{\textbf{\imprimirtitulo}}
            % ":" é adicionado de forma automática apenas se o subtítulo for preenchido.
            % "\unskip" remove o espaço extra antes dos dois-pontos caso o subtítulo for preenchido.
            \ifthenelse{\equal{\imprimirsubtitulo}{}}{}{\MakeUppercase{\textbf{\unskip: \\ \imprimirsubtitulo}} \\}
            % \end{DoubleSpace}
            \vfill
            {\large{\imprimirlocal, \imprimiruf \\ \imprimirano}}
        \end{center}
    \end{capa}
}
% ============================================== capa ==============================================

% ========================================= folha de rosto =========================================
\renewcommand{\imprimirfolhaderosto}{%
    \begin{folhaderosto}
        \thispagestyle{empty}
        \begin{center}
            \MakeUppercase{\imprimirautor} \\
            \vspace{4cm}
            \MakeUppercase{\textbf{\imprimirtitulo}}
            % ":" é adicionado de forma automática apenas se o subtítulo for preenchido.
            % "\unskip" remove o espaço extra antes dos dois-pontos caso o subtítulo for preenchido.
            \ifthenelse{\equal{\imprimirsubtitulo}{}}{}{\MakeUppercase{\textbf{\unskip: \\ \imprimirsubtitulo}} \\}
        \end{center}
        \vspace{1cm}
        \begin{flushright}
            \begin{SingleSpacing}
                % Deslocamento para a direita de 7 ou 8 cm, sendo 8 cm o mais comum para coincidir com o meio da folha
                \parbox{\dimexpr\textwidth-8cm\relax}{%
                    \imprimirpreambulo
                    \par\vspace{\onelineskip}
                    \imprimirorientadorRotulo~\imprimirorientador
                    \ifthenelse{\equal{\imprimircoorientador}{}}{}{\\ \imprimircoorientadorRotulo~\imprimircoorientador}
                }
            \end{SingleSpacing}
        \end{flushright}
        \vfill
        \begin{center}
            {\large{\imprimirlocal, \imprimiruf \\ \imprimirano}}
        \end{center}
    \end{folhaderosto}
}
% ========================================= folha de rosto =========================================

